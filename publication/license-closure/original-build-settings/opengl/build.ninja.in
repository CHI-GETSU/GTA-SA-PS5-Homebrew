# This is the build file for project "mesa"
# It is autogenerated by the Meson build system.
# Do not edit by hand.

ninja_required_version = 1.8.2

# Rules for module scanning.

# Rules for compiling.

rule c_COMPILER
 command = ${PROJECT_BUILD}/homebrew-gta-sa/sahin/launcher/.deps/native/ps5-payload-sdk/toolchain/../bin/prospero-clang $ARGS -MD -MQ $out -MF $DEPFILE -o $out -c $in
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = Compiling C object $out

rule cpp_COMPILER
 command = ${PROJECT_BUILD}/homebrew-gta-sa/sahin/launcher/.deps/native/ps5-payload-sdk/toolchain/../bin/prospero-clang++ $ARGS -MD -MQ $out -MF $DEPFILE -o $out -c $in
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = Compiling C++ object $out

# Rules for linking.

rule STATIC_LINKER
 command = rm -f $out && ${PROJECT_BUILD}/homebrew-gta-sa/sahin/launcher/.deps/native/ps5-payload-sdk/toolchain/../bin/prospero-ar $LINK_ARGS $out $in
 description = Linking static target $out

rule cpp_LINKER
 command = ${PROJECT_BUILD}/homebrew-gta-sa/sahin/launcher/.deps/native/ps5-payload-sdk/toolchain/../bin/prospero-clang++ $ARGS -o $out $in $LINK_ARGS
 description = Linking target $out

# Other rules

rule CUSTOM_COMMAND
 command = $COMMAND
 description = $DESC
 restat = 1

rule REGENERATE_BUILD
 command = ${PROSPERO_ROOT}/build/v0.2.0/build/mesa-python/bin/meson --internal regenerate ${OPENGL}/third_party/mesa-26.2.0 .
 description = Regenerating build files
 generator = 1

# Phony build target, always out of date

build PHONY: phony 

